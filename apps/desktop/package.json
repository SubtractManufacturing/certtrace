{
  "name": "@certtrace/desktop",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm -w build:packages && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "branding:icons": "node branding/generate-app-icons.mjs",
    "branding:installer": "node branding/generate-installer-assets.mjs",
    "branding": "pnpm branding:icons && pnpm branding:installer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@certtrace/core": "workspace:*",
    "@certtrace/file-storage": "workspace:*",
    "@certtrace/id-generator": "workspace:*",
    "@certtrace/library-engine": "workspace:*",
    "@certtrace/types": "workspace:*",
    "@certtrace/ui": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jimp": "^1.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
