{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CertTrace",
  "version": "0.0.0",
  "identifier": "com.subtractmanufacturing.certtrace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CertTrace",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0OEU0MzNGNjE5NEUzMzUKUldRMTQ1UmhQME9PVkNsNWtGSlhmOGE3OGJiZUE4L3BCVlQ4QmRpY1M4RmtGOW9UdmtEMEk1M00K",
      "endpoints": [
        "https://github.com/SubtractManufacturing/certtrace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
