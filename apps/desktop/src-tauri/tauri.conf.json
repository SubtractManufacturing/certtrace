{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CertTrace",
  "version": "1.0.0",
  "identifier": "com.subtractmanufacturing.certtrace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CertTrace",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "../branding/installer/dmg-background.png"
      }
    },
    "windows": {
      "nsis": {
        "sidebarImage": "../branding/installer/nsis-sidebar.bmp",
        "headerImage": "../branding/installer/nsis-header.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "../branding/installer/wix-banner.bmp",
        "dialogImagePath": "../branding/installer/wix-dialog.bmp"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENUVBQjM3NDUzMjZBMDkKUldRSmFqSkZONnRlbllmYlRrNXpaRHBWZ2JhbjhpV0xNTzNkM0Q0Vnl0QWYwN3FYdWlCcHBxd3MK",
      "endpoints": [
        "https://github.com/SubtractManufacturing/certtrace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
